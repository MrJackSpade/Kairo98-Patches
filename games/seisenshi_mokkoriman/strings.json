{
 "game": "Seisenshi Mokkoriman",
 "source_image_sha256": "cf18f98f6da24122cdd9f7b2af53bfe5c8796ffa85ecfddc5fe24fcfd10c96b7",
 "strings": [
  {
   "id": "m00001",
   "kind": "msg",
   "jp": "監督「豆ちゃん、遅いよ！　女優さんがお待ちかねだ。すぐに撮影するぞ！」\n豆造「ほーい！」",
   "en": "",
   "refs": [
    "MES0.D:0"
   ],
   "max_cols": 70
  },
  {
   "id": "m00002",
   "kind": "msg",
   "jp": "・・・・・・・・・・・・・・・・・③　・・・・・・・・・・・・・・・・・②　・・・・・・・・・・・・・・・・・①",
   "en": "",
   "refs": [
    "MES0.D:1"
   ],
   "max_cols": 70
  },
  {
   "id": "m00003",
   "kind": "msg",
   "jp": "　美香子は近付いてくる男が秋山大五郎だとすぐにわかった。\n　美香子にとって２回目の浮気だった。",
   "en": "",
   "refs": [
    "MES0.D:2"
   ],
   "max_cols": 70
  },
  {
   "id": "m00004",
   "kind": "msg",
   "jp": "　深夜のテニスコートでの密会。それを考えただけで胸が高鳴り、待っているだけで股間が濡れてくるのがわかった。",
   "en": "",
   "refs": [
    "MES0.D:3"
   ],
   "max_cols": 70
  },
  {
   "id": "m00005",
   "kind": "msg",
   "jp": "「奥さん、お待たせしました」\n　大五郎はそういって微笑みかけた。",
   "en": "",
   "refs": [
    "MES0.D:4"
   ],
   "max_cols": 70
  },
  {
   "id": "m00006",
   "kind": "msg",
   "jp": "　美香子は胸を押し付けるようにすり寄り背の高い大五郎を見上げて、甘えた声を出した。",
   "en": "",
   "refs": [
    "MES0.D:5"
   ],
   "max_cols": 70
  },
  {
   "id": "m00007",
   "kind": "msg",
   "jp": "「先生。今日は聞いていただきたいことがあるんです」\n「どんなことでしょう？」",
   "en": "",
   "refs": [
    "MES0.D:6"
   ],
   "max_cols": 70
  },
  {
   "id": "m00008",
   "kind": "msg",
   "jp": "「夫に私達のことがバレるんじゃないかと心配なんです」",
   "en": "",
   "refs": [
    "MES0.D:7"
   ],
   "max_cols": 70
  },
  {
   "id": "m00009",
   "kind": "msg",
   "jp": "「大丈夫ですよ、奥さん。だってご主人は出張中じゃないですか」\n「でも・・・」",
   "en": "",
   "refs": [
    "MES0.D:8"
   ],
   "max_cols": 70
  },
  {
   "id": "m00010",
   "kind": "msg",
   "jp": "「さあさあ、元気を出して、この間の続きから練習しましょう」",
   "en": "",
   "refs": [
    "MES0.D:9"
   ],
   "max_cols": 70
  },
  {
   "id": "m00011",
   "kind": "msg",
   "jp": "　テニスの続きではなく、責めの続きだった。",
   "en": "",
   "refs": [
    "MES0.D:10"
   ],
   "max_cols": 70
  },
  {
   "id": "m00012",
   "kind": "msg",
   "jp": "　大五郎は美香子の手を取ると自分の股間にあてがった。",
   "en": "",
   "refs": [
    "MES0.D:11"
   ],
   "max_cols": 70
  },
  {
   "id": "m00013",
   "kind": "msg",
   "jp": "　美香子は、すぐさま、\n「ああ・・・」\nとため息を漏らした。",
   "en": "",
   "refs": [
    "MES0.D:12"
   ],
   "max_cols": 70
  },
  {
   "id": "m00014",
   "kind": "msg",
   "jp": "　美香子はこのままこの場所で犯され、責められるのだと思った。",
   "en": "",
   "refs": [
    "MES0.D:13"
   ],
   "max_cols": 70
  },
  {
   "id": "m00015",
   "kind": "msg",
   "jp": "　それもいいと思った。\n　誰かに見られてしまうかもしれない。\n　見られながら貫かれたいと思った。",
   "en": "",
   "refs": [
    "MES0.D:14"
   ],
   "max_cols": 70
  },
  {
   "id": "m00016",
   "kind": "msg",
   "jp": "　大五郎の手が、股間に入っている。その指は休められることなく動き続けている。　愛液が内股のあたりを濡らしている。",
   "en": "",
   "refs": [
    "MES0.D:15"
   ],
   "max_cols": 70
  },
  {
   "id": "m00017",
   "kind": "msg",
   "jp": "　大五郎の指の動きにあわせてかすかに腰が動いている。\n　美香子は堪え難くなっていた。",
   "en": "",
   "refs": [
    "MES0.D:16"
   ],
   "max_cols": 70
  },
  {
   "id": "m00018",
   "kind": "msg",
   "jp": "　美香子は、男根を欲しいあまりに、\n「ああ・・・・・」\nというため息にも似た声を漏らした。",
   "en": "",
   "refs": [
    "MES0.D:17"
   ],
   "max_cols": 70
  },
  {
   "id": "m00019",
   "kind": "msg",
   "jp": "　挿入される瞬間、愛液がほとばしる音がした。\n　その音と共にそれはおとずれた。",
   "en": "",
   "refs": [
    "MES0.D:18"
   ],
   "max_cols": 70
  },
  {
   "id": "m00020",
   "kind": "msg",
   "jp": "　猛り狂った男根を後ろから突き上げられる度に美香子の精神は崩れ、無我夢中となっていった。",
   "en": "",
   "refs": [
    "MES0.D:19"
   ],
   "max_cols": 70
  },
  {
   "id": "m00021",
   "kind": "msg",
   "jp": "　美香子のよがる声はコートの隅々にまで響きわたり、止むことがなかった。",
   "en": "",
   "refs": [
    "MES0.D:20"
   ],
   "max_cols": 70
  },
  {
   "id": "m00022",
   "kind": "msg",
   "jp": "　美香子は大五郎の肩にしがみつき、無我夢中で尻をうち振っていた。もう何度いったのかわからなくなっていた。",
   "en": "",
   "refs": [
    "MES0.D:21"
   ],
   "max_cols": 70
  },
  {
   "id": "m00023",
   "kind": "msg",
   "jp": "　膣は完全に支配されている。大五郎も何度か射精したらしく精液が足元にまで滴り落ちてきていた。",
   "en": "",
   "refs": [
    "MES0.D:22"
   ],
   "max_cols": 70
  },
  {
   "id": "m00024",
   "kind": "msg",
   "jp": "　膣が精液で溢れた。溢れた精液が滴り\n落ちている。",
   "en": "",
   "refs": [
    "MES0.D:23"
   ],
   "max_cols": 70
  },
  {
   "id": "m00025",
   "kind": "msg",
   "jp": "　美香子は後ろ手に大五郎の男根を握り締めた。\n「お願い・・・これでして・・・」",
   "en": "",
   "refs": [
    "MES0.D:24"
   ],
   "max_cols": 70
  },
  {
   "id": "m00026",
   "kind": "msg",
   "jp": "　美香子は嘆願した。\n　大五郎は尻を高く突き出すように要求した。",
   "en": "",
   "refs": [
    "MES0.D:25"
   ],
   "max_cols": 70
  },
  {
   "id": "m00027",
   "kind": "msg",
   "jp": "　美香子は言われるままにした。\n　差し出しながら、猛り狂った男根で早く貫いて欲しいと思った。",
   "en": "",
   "refs": [
    "MES0.D:26"
   ],
   "max_cols": 70
  },
  {
   "id": "m00028",
   "kind": "msg",
   "jp": "　美香子は男根を支えた。\n　口腔性交に移った。",
   "en": "",
   "refs": [
    "MES0.D:27"
   ],
   "max_cols": 70
  },
  {
   "id": "m00029",
   "kind": "msg",
   "jp": "　大五郎は腰を振り、美香子の口の奥まで犯し、射精した。\n　美香子はそのまま精液を飲み干した。",
   "en": "",
   "refs": [
    "MES0.D:28"
   ],
   "max_cols": 70
  },
  {
   "id": "m00030",
   "kind": "msg",
   "jp": "　美香子はそのまま立ち上がり、猛り狂ったままの男根を自らの膣に挿入した。\n　大五郎は美香子の尻を支えた。",
   "en": "",
   "refs": [
    "MES0.D:29"
   ],
   "max_cols": 70
  },
  {
   "id": "m00031",
   "kind": "msg",
   "jp": "　美香子はそのままのけぞるようにして腰を振り、快楽をまさぐり始めた。",
   "en": "",
   "refs": [
    "MES0.D:30"
   ],
   "max_cols": 70
  },
  {
   "id": "m00032",
   "kind": "profile",
   "jp": "　　　森川小百合",
   "en": "",
   "refs": [
    "MES0.D:31"
   ],
   "max_cols": 22
  },
  {
   "id": "m00033",
   "kind": "profile",
   "jp": "　　　　２４才",
   "en": "",
   "refs": [
    "MES0.D:32",
    "MES5.D:46"
   ],
   "max_cols": 22
  },
  {
   "id": "m00034",
   "kind": "profile",
   "jp": "「若妻は～」の若妻役。",
   "en": "",
   "refs": [
    "MES0.D:33"
   ],
   "max_cols": 22
  },
  {
   "id": "m00035",
   "kind": "profile",
   "jp": "亭主にかまってもらえな",
   "en": "",
   "refs": [
    "MES0.D:34"
   ],
   "max_cols": 22
  },
  {
   "id": "m00036",
   "kind": "profile",
   "jp": "い若妻とインストラクタ",
   "en": "",
   "refs": [
    "MES0.D:35"
   ],
   "max_cols": 22
  },
  {
   "id": "m00037",
   "kind": "profile",
   "jp": "ーの情事を描く。金田豆",
   "en": "",
   "refs": [
    "MES0.D:36"
   ],
   "max_cols": 22
  },
  {
   "id": "m00038",
   "kind": "profile",
   "jp": "造にとっては生つばゴッ",
   "en": "",
   "refs": [
    "MES0.D:37"
   ],
   "max_cols": 22
  },
  {
   "id": "m00039",
   "kind": "profile",
   "jp": "クンもののお相手。",
   "en": "",
   "refs": [
    "MES0.D:38"
   ],
   "max_cols": 22
  },
  {
   "id": "m00040",
   "kind": "lyric",
   "jp": "　　　「　僕の愛をあげるよ　」",
   "en": "",
   "refs": [
    "MES0.D:39"
   ],
   "max_cols": 70
  },
  {
   "id": "m00041",
   "kind": "lyric",
   "jp": "　　作曲：小林雅巳　作詞：安田幹哉",
   "en": "",
   "refs": [
    "MES0.D:40"
   ],
   "max_cols": 70
  },
  {
   "id": "m00042",
   "kind": "lyric",
   "jp": "　　　　　海に解けだす夕陽",
   "en": "",
   "refs": [
    "MES0.D:41"
   ],
   "max_cols": 70
  },
  {
   "id": "m00043",
   "kind": "lyric",
   "jp": "　　　君のひとみが忘れられない",
   "en": "",
   "refs": [
    "MES0.D:42",
    "MES0.D:47"
   ],
   "max_cols": 70
  },
  {
   "id": "m00044",
   "kind": "lyric",
   "jp": "　　　　風よ、僕の愛を伝えて",
   "en": "",
   "refs": [
    "MES0.D:43"
   ],
   "max_cols": 70
  },
  {
   "id": "m00045",
   "kind": "lyric",
   "jp": "　　ああ、ファンタジー勇気をだして",
   "en": "",
   "refs": [
    "MES0.D:44",
    "MES0.D:49"
   ],
   "max_cols": 70
  },
  {
   "id": "m00046",
   "kind": "lyric",
   "jp": "　　　ロマンチックアドベンチャー",
   "en": "",
   "refs": [
    "MES0.D:45",
    "MES0.D:50"
   ],
   "max_cols": 70
  },
  {
   "id": "m00047",
   "kind": "lyric",
   "jp": "　　　　　輝き始める夜空",
   "en": "",
   "refs": [
    "MES0.D:46"
   ],
   "max_cols": 70
  },
  {
   "id": "m00048",
   "kind": "lyric",
   "jp": "　　　　海よ、僕の愛を伝えて",
   "en": "",
   "refs": [
    "MES0.D:48"
   ],
   "max_cols": 70
  },
