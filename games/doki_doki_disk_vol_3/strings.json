   "refs": [
    "3D_DISK.EDT:1feb"
   ],
   "max_cells": 77
  },
  {
   "id": "m00070",
   "kind": "msg",
   "jp": "　かなんか？」",
   "en": "",
   "refs": [
    "3D_DISK.EDT:2023"
   ],
   "max_cells": 77
  },
  {
   "id": "m00071",
   "kind": "msg",
   "jp": "　彦五郎：「そうです。雛子さんってきれいですね。」",
   "en": "",
   "refs": [
    "3D_DISK.EDT:202e"
   ],
   "max_cells": 77
  },
  {
   "id": "m00072",
   "kind": "msg",
   "jp": "　雛子：「えっ・！？や、やあだ、きれいだなんてぇ。ぼくそんなこと言われたの　",
