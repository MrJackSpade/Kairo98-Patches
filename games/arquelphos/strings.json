{
 "source_image_sha256": "7389d994d37407b9e0d10497953c670eb6032d541680d78550bc646178cbc4f0",
 "strings": [
  {
   "id": "m00001",
   "kind": "msg",
   "jp": "「ピットさん！！ひさしぶりです。げんきでしたか？{X1}女神様から聞いたんですけど、落ち込んでるんですかぁ・・・{X2}めずらしいですねぇ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0000"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line; {X2}: a new line"
  },
  {
   "id": "m00002",
   "kind": "msg",
   "jp": "「女の子についていろいろ教えてあげなさいって・・女神様が・・・でも、私自信ないです・・・だって、自分のことよくわかんないんです」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0001"
   ],
   "max_cells": 48
  },
  {
   "id": "m00003",
   "kind": "msg",
   "jp": "「あっ、面白い遊びがあるんですよ・・・・あっ、知ってました？よかったら私と遊びませんか・・・・・じゃあ、ピットさんが先ね・・・・・あっ、どうしたんですか？やっぱり私じゃあ・・・・」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0002"
   ],
   "max_cells": 48
  },
  {
   "id": "m00004",
   "kind": "msg",
   "jp": "「私・・・ピットさんをずーっと前から・・・・あっ、いえ、いいんです」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0003"
   ],
   "max_cells": 48
  },
  {
   "id": "m00005",
   "kind": "msg",
   "jp": "「ピットさん、がんばってください！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0004"
   ],
   "max_cells": 48
  },
  {
   "id": "m00006",
   "kind": "msg",
   "jp": "「ピットさん、強いですね・・・男の人って何でも本当に強いですねぇ。{X1}今日は私、森で木ノ実を集めてたんですよ・・・ほら、こんなに」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0005"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00007",
   "kind": "msg",
   "jp": "「お母様がサラダのドレッシングに使うんです、とっても美味しいですよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0006"
   ],
   "max_cells": 48
  },
  {
   "id": "m00008",
   "kind": "msg",
   "jp": "「このコート可愛いでしょ。お父様が旅のお土産に買ってきてくれたんですよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0007"
   ],
   "max_cells": 48
  },
  {
   "id": "m00009",
   "kind": "msg",
   "jp": "「あっ、この木ノ実ですか、とってもおいしいですよ。この丸っこいのと、このでっかいのが香ばしくて・・・・」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0008"
   ],
   "max_cells": 48
  },
  {
   "id": "m00010",
   "kind": "msg",
   "jp": "「うわーい、きもちいいわー」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0009"
   ],
   "max_cells": 48
  },
  {
   "id": "m00011",
   "kind": "msg",
   "jp": "「うふ、ピットーさん、はずかしいですよっ。{X1}女神様の御命令じゃなきゃ、こんなこと私・できないんですよっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000a"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00012",
   "kind": "msg",
   "jp": "「えっ、赤くなってるって・・・そんなことないですーう。大丈夫ですー。{X1}あっ、ピットさん、そこダメですーうっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000b"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00013",
   "kind": "msg",
   "jp": "「もう、もう・・わたし、はずかしいですーうっ・・・・{X1}ピットさんが女の子に慣れてないって・・女神様ったら、ほんとですか」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000c"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00014",
   "kind": "msg",
   "jp": "「こらーっ、ピット、あっ、ごめんなさい・・ピットさん、でも・・だめですーう」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000d"
   ],
   "max_cells": 48
  },
  {
   "id": "m00015",
   "kind": "msg",
   "jp": "「あん、やめてください、ピットさんっ。あん、あん。いやです、いやです、もう、もう、あーーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000e"
   ],
   "max_cells": 48
  },
  {
   "id": "m00016",
   "kind": "msg",
   "jp": "「あっ、あっああっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:000f"
   ],
   "max_cells": 48
  },
  {
   "id": "m00017",
   "kind": "msg",
   "jp": "「ああーん、ピットさんなんか変です。今何か入れませんでしたかああっ、ああっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0010"
   ],
   "max_cells": 48
  },
  {
   "id": "m00018",
   "kind": "msg",
   "jp": "「ああああーん、ピットさん何ですかこの感じ、いけないんですよこんなこと」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0011"
   ],
   "max_cells": 48
  },
  {
   "id": "m00019",
   "kind": "msg",
   "jp": "「ああーん、おかしいです、木ノ実が動いちゃいますーう」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0012"
   ],
   "max_cells": 48
  },
  {
   "id": "m00020",
   "kind": "msg",
   "jp": "「変ですよーっ、ピットさん、あああーん、あああーん、だめですーん、だめーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0013"
   ],
   "max_cells": 48
  },
  {
   "id": "m00021",
   "kind": "msg",
   "jp": "「ピットさん、これから旅は長いですけどくじけないでください」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0014"
   ],
   "max_cells": 48
  },
  {
   "id": "m00022",
   "kind": "msg",
   "jp": "「こんにちはピット！！うふ、どうして名前を知っているかって、面白いでしょ、女神様が教えてくれたの。{X1}さあ、あそぼっ！！ルールは分かるわね。ピットが先よ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0100"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00023",
   "kind": "msg",
   "jp": "「・・・あらっ、どうしたの？遊ばないの？私とじゃ・・嫌なの？残念だなー、ごほうびあげようと思ってたのに・・・・それはねえそれはないしょ・・・・うふ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0101"
   ],
   "max_cells": 48
  },
  {
   "id": "m00024",
   "kind": "msg",
   "jp": "「どうしたの？ピット－っ、がんばっ、がんばっ！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0102",
    "ARQ98.EXE#msg:0703"
   ],
   "max_cells": 48
  },
  {
   "id": "m00025",
   "kind": "msg",
   "jp": "「わーぁ、さすがだわーっ、えらいよーっピット！！{X1}うふ、ルーニャはねぇ、賢くて、まじめな人が好きなんだよ－ん。ピットは本当に真面目ね。ルーニャ大好きよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0103"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00026",
   "kind": "msg",
   "jp": "「このショール可愛いでしょ。お母様がわたしのために編んで下さったのよ。私のお母様は、このジュラ島の南の森のエルフ村の村長の娘なの。もちろんお父様は人間よ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0104"
   ],
   "max_cells": 48
  },
  {
   "id": "m00027",
   "kind": "msg",
   "jp": "「このエプロンはお父様がお母様に旅のお土産にとあげたのを私がもらっちゃったの。うふっ！悪い娘かなー・・・・だってぇー二人とも仲が良過ぎるんだよ－う」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0105"
   ],
   "max_cells": 48
  },
  {
   "id": "m00028",
   "kind": "msg",
   "jp": "「あっ、ピット顔が赤いぞーっ{X1}えっ、どうしてそんなに着てるんだって・・・どうしてかなーっ、可愛いからかな」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0106"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00029",
   "kind": "msg",
   "jp": "「えっ、赤くなってるって・・・そんなことないよ。大丈夫だもんピットこそ、どこ見てんのよーっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0107"
   ],
   "max_cells": 48
  },
  {
   "id": "m00030",
   "kind": "msg",
   "jp": "「こらーっ、ピットにげるなーっ！！{X1}もう、わたしだって・・・・わたしだってはずかしいんだから」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0108"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00031",
   "kind": "msg",
   "jp": "「レラ様これでよろしいですか。もうはずかしいーよーっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0109"
   ],
   "max_cells": 48
  },
  {
   "id": "m00032",
   "kind": "msg",
   "jp": "「こら、ピットなにするのーっ。ああーん、ああーん。もう、もうもう、あーーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010a"
   ],
   "max_cells": 48
  },
  {
   "id": "m00033",
   "kind": "msg",
   "jp": "「こら、ピットーっ、だめーっ！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010b"
   ],
   "max_cells": 48
  },
  {
   "id": "m00034",
   "kind": "msg",
   "jp": "「やだ、やだ、やだーあ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010c"
   ],
   "max_cells": 48
  },
  {
   "id": "m00035",
   "kind": "msg",
   "jp": "「ああーん、そこだめー」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010d"
   ],
   "max_cells": 48
  },
  {
   "id": "m00036",
   "kind": "msg",
   "jp": "「ああーん、ピットそうじゃないよー、ああーん、ああー」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010e"
   ],
   "max_cells": 48
  },
  {
   "id": "m00037",
   "kind": "msg",
   "jp": "「ああああーん、ピットそうよーっ、そうよーっ、あああああーんもう、もうだめーっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:010f"
   ],
   "max_cells": 48
  },
  {
   "id": "m00038",
   "kind": "msg",
   "jp": "「うふ、ピット好きになっちゃったよ・・・・またねーっ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0110"
   ],
   "max_cells": 48
  },
  {
   "id": "m00039",
   "kind": "msg",
   "jp": "「こんにちはピット、私美麗よ・・・大丈夫よ、あそぼう！！{X1}さあ遊びましょ！！ルールわかるわね。あなた、先よ{X2}・・・・・あらっ、どうした？下向いて・・・さみしいの」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0200"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line; {X2}: a new line"
  },
  {
   "id": "m00040",
   "kind": "msg",
   "jp": "「後でごほうびあげるよ、ピット・・・・ほらっピット」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0201"
   ],
   "max_cells": 48
  },
  {
   "id": "m00041",
   "kind": "msg",
   "jp": "「ピット－っ、くじけちゃダメよ！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0202"
   ],
   "max_cells": 48
  },
  {
   "id": "m00042",
   "kind": "msg",
   "jp": "「私、ジュラ島からすごい遠いマンダリンからきたのよ。{X1}私の老師様と女神様お友達なの。私、出張よ、うふ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0203"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00043",
   "kind": "msg",
   "jp": "「私達、女神様の僕（しもべ）ね、いろいろの国から来てるのよ。タイプもいろいろよ、うふ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0204"
   ],
   "max_cells": 48
  },
  {
   "id": "m00044",
   "kind": "msg",
   "jp": "「人間界では家はブリテン、料理はマンダリン、奥さんジャパニーズだって！！でも、マンダリンにも可愛い娘たくさんいるよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0205"
   ],
   "max_cells": 48
  },
  {
   "id": "m00045",
   "kind": "msg",
   "jp": "「わお、かわいいでしょう、ピット！！{X1}私、１８才になったの。もうおとなよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0206"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00046",
   "kind": "msg",
   "jp": "「このほうがすっきりするよ、うふ・・・・{X1}ほらっ、可愛いでしょう」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0207"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00047",
   "kind": "msg",
   "jp": "「いやん、はずかしい！！{X1}わたし、あまり大きくないでしょ・・・・でも・・ツゥン、ツゥンしてるよ、ほら」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0208"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00048",
   "kind": "msg",
   "jp": "「ああーんピット、わたし・・・はずかしいよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0209"
   ],
   "max_cells": 48
  },
  {
   "id": "m00049",
   "kind": "msg",
   "jp": "「ピット、ピット・・・はあーん・・・はあーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020a"
   ],
   "max_cells": 48
  },
  {
   "id": "m00050",
   "kind": "msg",
   "jp": "「だめーん、だめーんそこは弱いの」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020b"
   ],
   "max_cells": 48
  },
  {
   "id": "m00051",
   "kind": "msg",
   "jp": "「はーん、はーん、ツゥン、ツゥンしてる」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020c"
   ],
   "max_cells": 48
  },
  {
   "id": "m00052",
   "kind": "msg",
   "jp": "「ピットそんなとこ、なめたらだめー」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020d"
   ],
   "max_cells": 48
  },
  {
   "id": "m00053",
   "kind": "msg",
   "jp": "「もう・・もう、びちょびちょよーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020e"
   ],
   "max_cells": 48
  },
  {
   "id": "m00054",
   "kind": "msg",
   "jp": "「はあはあはあはあ、あーーん、いくーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:020f"
   ],
   "max_cells": 48
  },
  {
   "id": "m00055",
   "kind": "msg",
   "jp": "「こんどマンダリンきてピット。私・・待ってるよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0210"
   ],
   "max_cells": 48
  },
  {
   "id": "m00056",
   "kind": "msg",
   "jp": "「こんにちはピット、女神様から・・・聞いたの、{X1}さあ遊びましょ！！ルールは知ってるよね。あなたが先ね」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0300"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00057",
   "kind": "msg",
   "jp": "「・・・・・あはっ、たのしいなーあ・・・」{X1}「女神様がねーえ、頑張った男の子にはごほうびあげなきゃだめだって。わたし何にしょうかな」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0301"
   ],
   "max_cells": 48,
   "note": "{X1}: control 08h, a key wait, the window cleared, control 07h"
  },
  {
   "id": "m00058",
   "kind": "msg",
   "jp": "「まけちゃあダメ－っ、ピットー！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0302"
   ],
   "max_cells": 48
  },
  {
   "id": "m00059",
   "kind": "msg",
   "jp": "「へーえ、うまいのねーえ。{X1}だけど、詩麻だって強いんだから・・・・・・{X2}１５だって、バカにしてるー、アーーン、バカにしてるーっ！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0303"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line; {X2}: a new line"
  },
  {
   "id": "m00060",
   "kind": "msg",
   "jp": "「暑いわー。まいっちゃあう」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0304"
   ],
   "max_cells": 48
  },
  {
   "id": "m00061",
   "kind": "msg",
   "jp": "「このＴシャツ可愛いでしょ。おねえさまがくれたのよ」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0305"
   ],
   "max_cells": 48
  },
  {
   "id": "m00062",
   "kind": "msg",
   "jp": "「ちょっとー、目付が変だよーん！！{X1}だから子供はやだよ！！」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0306"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00063",
   "kind": "msg",
   "jp": "「なによ、顔なんて赤くなんてないもん。{X1}ちょっとーどこ、のぞいてんですかー・・・もしもーし、もしもーし」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0307"
   ],
   "max_cells": 48,
   "note": "{X1}: a new line"
  },
  {
   "id": "m00064",
   "kind": "msg",
   "jp": "「ああ、発育が悪いって思ってるー、やだあ、もう、私はこぶりなの！！女神様、これって、いけないんじゃないですーう？まいったなーもう」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0308"
   ],
   "max_cells": 48
  },
  {
   "id": "m00065",
   "kind": "msg",
   "jp": "「やっだーん、もう、はうーーん」",
   "en": "",
   "refs": [
    "ARQ98.EXE#msg:0309"
   ],
   "max_cells": 48
