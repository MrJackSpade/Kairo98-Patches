   "refs": [
    "START.MES:29",
    "JOSHI/START.MES:29",
    "NURSE/START.MES:29",
    "BUS/START.MES:31"
   ],
   "max_cells": 78
  },
  {
   "id": "m00029",
   "kind": "msg",
   "jp": "もう一度、あなたに同じ仕事を依頼します。どうか、がんばってください。",
