   "max_cells": 13
  },
  {
   "id": "m00020",
   "kind": "msg",
   "jp": "　　　　　　　　　　　　　　　よーし。現像だ！！",
   "en": "",
   "refs": [
    "START.MES:21",
    "JOSHI/START.MES:21",
    "NURSE/START.MES:21",
    "BUS/START.MES:23"
